# pixi environments
.pixi/*
!.pixi/config.toml

# scratch disk (persists through crashes, never committed)
scratch/*
!scratch/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# secrets (keep .env.example committed as the template)
.env
!.env.example

# generated data (python -m selectia.data.core / .mixture)
data/*.pkl
data/*.jsonl

# training output (checkpoints are GBs; publish them to the Hub, not to git)
runs/
