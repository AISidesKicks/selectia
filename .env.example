# Copy to .env and fill in. Load it in your shell with:
#   set -a; source .env; set +a
# .env is gitignored, this template is not.

# Hugging Face write token, used by scripts/upload_hf.py to push the released models.
# Create one at https://huggingface.co/settings/tokens with the "write" role.
# Do not commit the real value.
HF_TOKEN=

# Optional: keep the model and dataset cache off the home partition. The project uses
# $SCRATCH (gitignored) for this, so a normal HF run costs no extra setup.
# HF_HOME=/path/to/scratch/hf

# Optional: only needed for gated or private repos (all four LFM2.5 bases are ungated).
# HF_HUB_ENABLE_HF_TRANSFER=0
